[Unit]
Description=MusicIndex live publisher for %i
Documentation=file:///usr/share/doc/musicindex-live-publisher/musicindex-live-publisher-deploy.md
# A revoked or wrong token is fatal and recurs on every restart. Without a start
# limit that would restart forever; with one, systemd gives up and marks the
# unit failed so `systemctl --user status` shows the real problem.
StartLimitIntervalSec=300
StartLimitBurst=5
# Each future player instance has its own config and token directory.
AssertPathExists=%h/.config/musicindex-live-publisher/%i/config.toml
AssertPathExists=%h/.config/musicindex-live-publisher/%i/tokens

[Service]
Type=simple
ExecStart=/usr/bin/musicindex-live-publisher \
    --config %h/.config/musicindex-live-publisher/%i/config.toml \
    --watch-dir %t/musicindex-live-publisher/%i/nowplaying
Restart=on-failure
RestartSec=5s

# One publisher instance owns one producer drop directory.
RuntimeDirectory=musicindex-live-publisher/%i/nowplaying
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

# Each configured target reads its own broadcaster token from token_file.
# Keep token files under ~/.config/musicindex-live-publisher/<instance>/tokens
# with mode 0600, and keep the parent directory mode 0700.

NoNewPrivileges=true
ProtectSystem=strict
# read-only rather than true: the service reads its own config from ~/.config.
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=default.target
