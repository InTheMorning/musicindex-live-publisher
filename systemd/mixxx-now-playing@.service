[Unit]
Description=Mixxx now-playing producer for MusicIndex (%i)
Documentation=file:///usr/share/doc/musicindex-live-publisher/musicindex-live-publisher-deploy.md
# The publisher instance owns the drop directory, so it must start first.
Wants=musicindex-live-publisher@%i.service
After=musicindex-live-publisher@%i.service

[Service]
Type=simple
ExecStart=/usr/bin/mixxx-now-playing --format json --instance %i
# The producer exits cleanly when Mixxx is not running. Restart=always with a
# short delay turns that into a cheap poll. When Mixxx starts later, the
# producer comes back on its own.
Restart=always
RestartSec=10s
# Exit status 3 means that a different Mixxx producer holds the Mixxx lock
# (ADR 0021). systemd must not restart this producer after this status. A
# restart can take the lock later with no command from the operator.
RestartPreventExitStatus=3

NoNewPrivileges=true
ProtectSystem=strict
# The producer reads ~/.mixxx/mixxxdb.sqlite and the V4V music library.
ProtectHome=read-only
PrivateTmp=true
# The first two directories are the drop directories of this instance.
# The third directory holds the state of the one Mixxx producer (ADR 0021).
RuntimeDirectory=musicindex-live-publisher/%i/nowplaying musicindex-live-publisher/%i/display mixxx-now-playing
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# ADR 0006: the producer opens the raw MIDI device of the V4V card in /dev/snd.
# A user service has only the device access of its user.
PrivateDevices=false
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
